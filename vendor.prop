#
# vendor props for judypn
#

# Bluetooth
bluetooth.device.default_name=LG V40 ThinQ

# Camera
ro.vendor.lge.aux.camera=2
vendor.lge.faceprint.use.camera=0
vendor.camera.aux.physical=5

# Fingerprint
persist.vendor.fingerprint.type=rear

# Misc
ro.vendor.lge.build.target_country=COM
ro.vendor.lge.build.target_operator=LAO
ro.vendor.lge.capp_cupss.rootdir=/oem/OP
ro.vendor.lge.swversion=V40530g

# USB
vendor.usb.product_string=LG V40 ThinQ
